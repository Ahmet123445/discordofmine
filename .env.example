# Frontend
NEXT_PUBLIC_API_URL=https://discordofmine-server.onrender.com
NEXT_PUBLIC_RADIO_FEATURE_ENABLED=false
NEXT_PUBLIC_TURN_URL=turn:your-server-ip:3478?transport=udp,turn:your-server-ip:3478?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=turn-username
NEXT_PUBLIC_TURN_PASSWORD=turn-password

# Backend
PORT=3001
JWT_SECRET=super-secure-production-secret-change-me
TURN_URL=turn:your-server-ip:3478?transport=udp,turn:your-server-ip:3478?transport=tcp
TURN_USERNAME=turn-username
TURN_PASSWORD=turn-password
MUSIC_FRAME_DURATION_MS=10
MUSIC_PREBUFFER_FRAMES=72
MUSIC_REBUFFER_FRAMES=40
MUSIC_MAX_CATCHUP_FRAMES=4
MUSIC_CURRENT_PREFETCH_WAIT_TIMEOUT_MS=45000
MUSIC_PREFERRED_AUDIO_EXT=webm

# Radio feature (canli radyo yayinlari - muzik botundan bagimsiz)
RADIO_FEATURE_ENABLED=false
RADIO_DEFAULT_VOLUME=40
RADIO_PREBUFFER_FRAMES=72
RADIO_REBUFFER_FRAMES=40
RADIO_LOG_LEVEL=info
# Override ffmpeg binary used for radio streams. Leave empty to auto-detect:
# prefers /usr/bin/ffmpeg (system) over bundled ffmpeg-static because the
# static build can segfault on network inputs on some Linux hosts.
# RADIO_FFMPEG_PATH=/usr/bin/ffmpeg
# Optional yt-dlp config for YouTube music playback
# YTDLP_PATH=yt-dlp
# YTDLP_COOKIES_PATH=C:\\path\\to\\yt-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_BROWSER_PROFILE=Default
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,tv_simply
# Render handles NODE_ENV automatically
