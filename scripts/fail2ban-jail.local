# /etc/fail2ban/jail.local
# Managed by discordofmine deploy; keeps assistant + Tailscale out of bans.

[DEFAULT]
# --- Whitelist: never ban these sources -----------------------------------
# Localhost
# Tailscale CGNAT (100.64.0.0/10)
# Cloudflare edge + WARP (official IPv4 ranges from cloudflare.com/ips-v4,
# covers all outbound WARP client egress IPs)
# IPv6: localhost + Cloudflare official v6 ranges
ignoreip = 127.0.0.1/8
           ::1
           100.64.0.0/10
           fd7a:115c:a1e0::/48
           173.245.48.0/20
           103.21.244.0/22
           103.22.200.0/22
           103.31.4.0/22
           141.101.64.0/18
           108.162.192.0/18
           190.93.240.0/20
           188.114.96.0/20
           197.234.240.0/22
           198.41.128.0/17
           162.158.0.0/15
           104.16.0.0/12
           172.64.0.0/13
           131.0.72.0/22
           2400:cb00::/32
           2606:4700::/32
           2803:f800::/32
           2405:b500::/32
           2405:8100::/32
           2a06:98c0::/29
           2c0f:f248::/32

# --- Default jail behaviour ------------------------------------------------
# Tolerant first-time threshold; escalate aggressively on repeat offenders.
findtime  = 10m
maxretry  = 6
bantime   = 15m

# Exponential re-ban for persistent attackers
bantime.increment  = true
bantime.multipliers = 1 2 4 8 16 32 64
bantime.maxtime    = 7d
bantime.rndtime    = 1m
bantime.overalljails = true

# Use systemd journal as the log source (Ubuntu 24.04 default).
backend = systemd

# --- SSH protection --------------------------------------------------------
[sshd]
enabled  = true
mode     = aggressive
port     = ssh
filter   = sshd
logpath  = %(sshd_log)s
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
