FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_TURN_URL
ARG NEXT_PUBLIC_TURN_USERNAME
ARG NEXT_PUBLIC_TURN_PASSWORD
ARG NEXT_PUBLIC_RADIO_FEATURE_ENABLED
ARG NEXT_PUBLIC_ICE_SERVERS_JSON

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_TURN_URL=$NEXT_PUBLIC_TURN_URL
ENV NEXT_PUBLIC_TURN_USERNAME=$NEXT_PUBLIC_TURN_USERNAME
ENV NEXT_PUBLIC_TURN_PASSWORD=$NEXT_PUBLIC_TURN_PASSWORD
ENV NEXT_PUBLIC_RADIO_FEATURE_ENABLED=$NEXT_PUBLIC_RADIO_FEATURE_ENABLED
ENV NEXT_PUBLIC_ICE_SERVERS_JSON=$NEXT_PUBLIC_ICE_SERVERS_JSON

RUN npm run build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["npm", "start"]
